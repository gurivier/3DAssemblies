####### Compile

AssemblyWindow.o: AssemblyWindow.cpp AssemblyWindow.h \
		TargetManager.h \
		Cartouche.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o AssemblyWindow.o AssemblyWindow.cpp

CameraArea.o: CameraArea.cpp CameraArea.h \
		TargetManager.h \
		Cartouche.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o CameraArea.o CameraArea.cpp

Cartouche.o: Cartouche.cpp Cartouche.h \
		AssemblyWindow.h \
		TargetManager.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Cartouche.o Cartouche.cpp

ConfigurationWindow.o: ConfigurationWindow.cpp ConfigurationWindow.h \
		TargetManager.h \
		Cartouche.h \
		CameraArea.h \
		v4l2grab.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o ConfigurationWindow.o ConfigurationWindow.cpp

main.o: main.cpp ConfigurationWindow.h \
		TargetManager.h \
		Cartouche.h \
		AssemblyWindow.h \
		v4l2grab.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

TargetManager.o: TargetManager.cpp TargetManager.h \
		Cartouche.h \
		v4l2grab.h \
		AssemblyWindow.h \
		ConfigurationWindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o TargetManager.o TargetManager.cpp

v4l2grab.o: v4l2grab.c 
	$(CC) -c $(CFLAGS) $(INCPATH) -o v4l2grab.o v4l2grab.c

moc_AssemblyWindow.o: moc_AssemblyWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_AssemblyWindow.o moc_AssemblyWindow.cpp

moc_CameraArea.o: moc_CameraArea.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_CameraArea.o moc_CameraArea.cpp

moc_ConfigurationWindow.o: moc_ConfigurationWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_ConfigurationWindow.o moc_ConfigurationWindow.cpp

